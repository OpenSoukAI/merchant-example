# Nothing is deployed on a public chain yet. Fill these from the deployment you
# were given; the addresses below are placeholders, not any network's real values.

MERCHANT_PORT=8083

# ProtocolAddressRegistry. The only protocol address you configure — the split
# router is read out of it at runtime.
MERCHANT_ADDRESS_REGISTRY=0x0000000000000000000000000000000000000000

# The USDC contract on the chain you are serving.
MERCHANT_USDC=0x0000000000000000000000000000000000000000

# CAIP-2 chain id, copied into accepts[0].network verbatim.
MERCHANT_NETWORK=eip155:0

# Your price, in USDC base units. 1000000 = 1 USDC.
MERCHANT_PRICE_BASE_UNITS=1000000

# The OpenSouk facilitator you were given. A deployment setting, not a fixed host.
MERCHANT_FACILITATOR_URL=http://127.0.0.1:8082

# This server's own public URL, used as the 402's resource URL.
MERCHANT_PUBLIC_URL=http://127.0.0.1:8083

# Where your ordinary, non-referral route is paid. Untouched by any of this.
MERCHANT_DIRECT_PAY_TO=0x0000000000000000000000000000000000000000

# An RPC endpoint for the chain above.
MERCHANT_RPC_URL=http://127.0.0.1:8545
